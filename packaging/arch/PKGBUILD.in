# shellcheck shell=bash
# shellcheck disable=SC2034,SC2154
# Generated by scripts/prepare-arch.py from the local vendored source archive.
pkgname=p4ui
pkgver=@VERSION@
pkgrel=1
pkgdesc='A keyboard-driven terminal interface for Perforce'
arch=('x86_64' 'aarch64')
url='https://github.com/adamflott/p4ui'
license=('MIT')
options=('!debug') # The release profile already strips symbols.
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'python')
optdepends=('helix-cli: Perforce command-line client (or install p4 from Perforce)')
source=("p4ui-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
  cd "p4ui-${pkgver}" || return
  CARGO_NET_OFFLINE=true cargo build --release --frozen
}

check() {
  cd "p4ui-${pkgver}" || return
  CARGO_NET_OFFLINE=true cargo test --frozen
}

package() {
  cd "p4ui-${pkgver}" || return
  install -Dm755 target/release/p4ui "${pkgdir}/usr/bin/p4ui"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/p4ui/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES "${pkgdir}/usr/share/licenses/p4ui/THIRD_PARTY_NOTICES"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/p4ui/README.md"
  install -Dm644 docs/BUILDING.md "${pkgdir}/usr/share/doc/p4ui/BUILDING.md"
}
