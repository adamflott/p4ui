#!/usr/bin/make -f
export CARGO_TARGET_DIR = $(CURDIR)/target/debian
export CARGO_NET_OFFLINE = true

%:
	dh $@

override_dh_auto_build:
	cargo build --release --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --frozen
endif

override_dh_auto_install:
	install -Dm755 target/debian/release/p4ui debian/p4ui/usr/bin/p4ui

override_dh_auto_clean:
	rm -rf target/debian

# dh_clean normally deletes *.orig; these are checksum-protected Cargo sources.
override_dh_clean:
	dh_clean -Xvendor/

# Autotools helpers must not rewrite files inside vendored Rust crates either.
override_dh_update_autotools_config override_dh_autoreconf:
